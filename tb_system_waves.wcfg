<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_system_snap.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_system" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="10000.000 ns"></ZoomEndTime>
      <Cursor1Time time="2624.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="260"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />

   <!-- GROUP 1: SYSTEM CLOCK & CONTROL -->
   <wvobject fp_name="group_control" type="group">
      <obj_property name="label">1. Control &amp; Reset</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/clk" type="logic">
         <obj_property name="ElementShortName">clk</obj_property>
         <obj_property name="ObjectShortName">clk</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/rst_n" type="logic">
         <obj_property name="ElementShortName">rst_n</obj_property>
         <obj_property name="ObjectShortName">rst_n</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/csr_run" type="logic">
         <obj_property name="ElementShortName">csr_run</obj_property>
         <obj_property name="ObjectShortName">csr_run</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/csr_dds_bin" type="array">
         <obj_property name="ElementShortName">csr_dds_bin[7:0]</obj_property>
         <obj_property name="ObjectShortName">csr_dds_bin[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
   </wvobject>

   <!-- GROUP 2: TIME DOMAIN INPUT (DDS) -->
   <wvobject fp_name="group_dds" type="group">
      <obj_property name="label">2. Time-Domain Input (DDS)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/dut/fft_in_vld" type="logic">
         <obj_property name="ElementShortName">fft_in_vld</obj_property>
         <obj_property name="ObjectShortName">fft_in_vld</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/frame_cnt" type="array">
         <obj_property name="ElementShortName">frame_cnt[7:0]</obj_property>
         <obj_property name="ObjectShortName">frame_cnt[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/dds_out" type="array">
         <obj_property name="ElementShortName">dds_out[15:0]</obj_property>
         <obj_property name="ObjectShortName">dds_out[15:0]</obj_property>
         <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
         <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
         <obj_property name="CellHeight">70</obj_property>
      </wvobject>
   </wvobject>

   <!-- GROUP 3: 256-POINT FFT CORE -->
   <wvobject fp_name="group_fft" type="group">
      <obj_property name="label">3. 256-Pt Radix-2² FFT</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/dut/fft_out_vld" type="logic">
         <obj_property name="ElementShortName">fft_out_vld</obj_property>
         <obj_property name="ObjectShortName">fft_out_vld</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/sample_cnt" type="array">
         <obj_property name="ElementShortName">sample_cnt[7:0]</obj_property>
         <obj_property name="ObjectShortName">sample_cnt[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/natural_bin" type="array">
         <obj_property name="ElementShortName">natural_bin[7:0]</obj_property>
         <obj_property name="ObjectShortName">natural_bin[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/fft_out_r" type="array">
         <obj_property name="ElementShortName">fft_out_r[15:0]</obj_property>
         <obj_property name="ObjectShortName">fft_out_r[15:0]</obj_property>
         <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
         <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
         <obj_property name="CellHeight">50</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/fft_out_i" type="array">
         <obj_property name="ElementShortName">fft_out_i[15:0]</obj_property>
         <obj_property name="ObjectShortName">fft_out_i[15:0]</obj_property>
         <obj_property name="Radix">SIGNEDDECRADIX</obj_property>
         <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
         <obj_property name="CellHeight">50</obj_property>
      </wvobject>
   </wvobject>

   <!-- GROUP 4: MAGNITUDE & PEAK DETECTION -->
   <wvobject fp_name="group_peak" type="group">
      <obj_property name="label">4. Magnitude &amp; Peak Detector</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/dut/mag_out" type="array">
         <obj_property name="ElementShortName">mag_out[16:0]</obj_property>
         <obj_property name="ObjectShortName">mag_out[16:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         <obj_property name="WaveformStyle">STYLE_ANALOG</obj_property>
         <obj_property name="CellHeight">60</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/peak_done" type="logic">
         <obj_property name="ElementShortName">peak_done</obj_property>
         <obj_property name="ObjectShortName">peak_done</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/peak_bin" type="array">
         <obj_property name="ElementShortName">peak_bin[7:0]</obj_property>
         <obj_property name="ObjectShortName">peak_bin[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/peak_mag" type="array">
         <obj_property name="ElementShortName">peak_mag[16:0]</obj_property>
         <obj_property name="ObjectShortName">peak_mag[16:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/peak_bin_lat" type="array">
         <obj_property name="ElementShortName">peak_bin_lat[7:0]</obj_property>
         <obj_property name="ObjectShortName">peak_bin_lat[7:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
   </wvobject>

   <!-- GROUP 5: PING-PONG BUFFER -->
   <wvobject fp_name="group_pp" type="group">
      <obj_property name="label">5. Ping-Pong Buffer (CTL Check)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/dut/pp_frame_done" type="logic">
         <obj_property name="ElementShortName">pp_frame_done</obj_property>
         <obj_property name="ObjectShortName">pp_frame_done</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/u_pp/wr_bank" type="logic">
         <obj_property name="ElementShortName">wr_bank</obj_property>
         <obj_property name="ObjectShortName">wr_bank</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/u_pp/rd_bank" type="logic">
         <obj_property name="ElementShortName">rd_bank</obj_property>
         <obj_property name="ObjectShortName">rd_bank</obj_property>
      </wvobject>
   </wvobject>

   <!-- GROUP 6: UART & VGA OUTPUTS -->
   <wvobject fp_name="group_io" type="group">
      <obj_property name="label">6. UART, VGA &amp; LEDs</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_system/dut/tx_seq" type="array">
         <obj_property name="ElementShortName">tx_seq[3:0]</obj_property>
         <obj_property name="ObjectShortName">tx_seq[3:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/dut/uart_data" type="array">
         <obj_property name="ElementShortName">uart_data[7:0]</obj_property>
         <obj_property name="ObjectShortName">uart_data[7:0]</obj_property>
         <obj_property name="Radix">ASCIIRADIX</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/uart_tx" type="logic">
         <obj_property name="ElementShortName">uart_tx</obj_property>
         <obj_property name="ObjectShortName">uart_tx</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/vga_hsync" type="logic">
         <obj_property name="ElementShortName">vga_hsync</obj_property>
         <obj_property name="ObjectShortName">vga_hsync</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/vga_vsync" type="logic">
         <obj_property name="ElementShortName">vga_vsync</obj_property>
         <obj_property name="ObjectShortName">vga_vsync</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_system/led" type="array">
         <obj_property name="ElementShortName">led[3:0]</obj_property>
         <obj_property name="ObjectShortName">led[3:0]</obj_property>
         <obj_property name="Radix">HEXRADIX</obj_property>
      </wvobject>
   </wvobject>
</wave_config>
